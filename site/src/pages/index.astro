---
import Base from '../layouts/Base.astro';
import { routes } from '../lib/data.ts';

const factions = ['Alliance', 'Horde'] as const;
---
<Base title="ForeverXP: free WoW Forever 1–30 leveling routes"
      description="Pick your race and follow a free step-by-step quest route from level 1 to 30 in WoW Forever.">
  <main id="main">
    <h1>Choose your race</h1>
    <p class="lead">Every route runs from level 1 to 30. Your progress is saved in this browser.</p>
    <p class="beta-note"><strong>Beta:</strong> routes come from open quest data and have not been played through yet.</p>
    {factions.map((faction) => (
      <section aria-labelledby={`f-${faction}`} class="faction">
        <h2 id={`f-${faction}`} class={faction.toLowerCase()}>
          <span aria-hidden="true">{faction === 'Alliance' ? '◆' : '▲'}</span> {faction}
        </h2>
        <ul class="races">
          {routes.filter((r) => r.faction === faction).map((r) => (
            <li><a class="race" href={`/${r.id}/`}>{r.race}<span class="sub">Levels {r.levelRange[0]}–{r.levelRange[1]}</span></a></li>
          ))}
          <li>
            <span class="race soon" aria-disabled="true">Skyborne<span class="sub">Coming soon</span></span>
          </li>
        </ul>
      </section>
    ))}
    <p class="note">Skyborne starts on Zephras Isle, which is new in Forever and not in the open data yet. Its routes follow once the quests are recorded.</p>
  </main>
</Base>

<style>
  .lead { font-size: 18px; }
  .beta-note, .note { color: var(--muted); }
  .beta-note strong { color: var(--warn); }
  .faction h2 { font-size: 24px; }
  .faction h2.alliance { color: var(--alliance); }
  .faction h2.horde { color: var(--horde); }
  .races { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
  .race {
    display: flex; flex-direction: column; gap: 2px; min-height: 64px; padding: 12px 16px;
    background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
    color: var(--text); text-decoration: none; font-size: 18px; font-weight: 600;
  }
  a.race:hover { border-color: var(--gold); background: var(--raised); }
  .race .sub { font: 14px var(--font-mono); color: var(--muted); font-weight: 400; }
  .race.soon { border-style: dashed; color: var(--muted); }
</style>
