---
import RouteView from '../islands/RouteView.tsx';
import Base from '../layouts/Base.astro';
import { routes } from '../lib/data.ts';
import type { Route } from '../lib/steps.ts';

export function getStaticPaths() {
  return routes.map((route) => ({ params: { route: route.id }, props: { route } }));
}

const { route } = Astro.props as { route: Route };
const title = `${route.race} 1–${route.levelRange[1]} leveling route · ForeverXP`;
---
<Base title={title}
      description={`Free step-by-step ${route.race} (${route.faction}) quest route from level ${route.levelRange[0]} to ${route.levelRange[1]} in WoW Forever.`}>
  <a slot="skip" class="skip-link" href="#current-step">Skip to current step</a>
  <main id="main">
    <h1 class="route-h1">{route.race} 1–{route.levelRange[1]} route</h1>
    <RouteView client:load route={route} />
  </main>
</Base>

<style>
  .route-h1 { font-size: 32px; margin: 16px 0 0; }
</style>
