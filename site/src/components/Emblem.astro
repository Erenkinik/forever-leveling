---
// ForeverXP emblem: a heraldic shield with two level-up chevrons. Original artwork, no Blizzard marks.
interface Props {
  size?: number;
  class?: string;
}
const { size = 40, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="fxp-gold" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffe7a3" />
      <stop offset=".55" stop-color="#f0c060" />
      <stop offset="1" stop-color="#b8862e" />
    </linearGradient>
    <linearGradient id="fxp-field" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3a2c18" />
      <stop offset="1" stop-color="#140f09" />
    </linearGradient>
  </defs>
  <path d="M32 3 L57 11 V30 C57 46.5 46 56.5 32 61 C18 56.5 7 46.5 7 30 V11 Z"
        fill="url(#fxp-field)" stroke="url(#fxp-gold)" stroke-width="3" stroke-linejoin="round" />
  <path d="M32 9 L51 15 V30 C51 42.5 43 50.5 32 54.5 C21 50.5 13 42.5 13 30 V15 Z"
        fill="none" stroke="#b8862e" stroke-opacity=".55" stroke-width="1" />
  <path d="M20 43 L32 31 L44 43" fill="none" stroke="url(#fxp-gold)" stroke-width="5" stroke-linecap="round"
        stroke-linejoin="round" />
  <path d="M20 31 L32 19 L44 31" fill="none" stroke="url(#fxp-gold)" stroke-width="5" stroke-linecap="round"
        stroke-linejoin="round" />
</svg>
