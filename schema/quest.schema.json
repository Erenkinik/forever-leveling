{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foreverxp/schema/quest.schema.json",
  "title": "Quest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "level",
    "minLevel",
    "races",
    "classes",
    "factions",
    "prereqs",
    "start",
    "end",
    "objectives",
    "inForever",
    "sources",
    "lineages",
    "conflicts",
    "confidence",
    "seenInBuild"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "level": {
      "type": [
        "integer",
        "null"
      ]
    },
    "minLevel": {
      "type": [
        "integer",
        "null"
      ]
    },
    "races": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "classes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "factions": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "enum": [
          "Alliance",
          "Horde"
        ]
      },
      "uniqueItems": true
    },
    "prereqs": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "prereqsAny": {
      "description": "true: the prereqs are alternatives and any one of them is enough (versions of one quest, or breadcrumbs to the same NPC); false or absent: all are required.",
      "type": "boolean"
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "name",
        "uiMapId",
        "x",
        "y"
      ],
      "properties": {
        "type": {
          "enum": [
            "npc",
            "item",
            "object",
            null
          ]
        },
        "id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "uiMapId": {
          "type": [
            "integer",
            "null"
          ]
        },
        "x": {
          "type": [
            "number",
            "null"
          ]
        },
        "y": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "end": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "name",
        "uiMapId",
        "x",
        "y"
      ],
      "properties": {
        "type": {
          "enum": [
            "npc",
            "item",
            "object",
            null
          ]
        },
        "id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "uiMapId": {
          "type": [
            "integer",
            "null"
          ]
        },
        "x": {
          "type": [
            "number",
            "null"
          ]
        },
        "y": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "objectives": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "units",
        "items",
        "objects"
      ],
      "properties": {
        "units": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "inForever": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "items": {
        "enum": [
          "wago-db2",
          "pfquest",
          "cmangos",
          "wowhead-manual",
          "recorder",
          "lodestar",
          "mittenquest",
          "evergreen",
          "polestar",
          "rxp-free",
          "tugs"
        ]
      }
    },
    "lineages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "enum": [
        "unverified",
        "cross-checked",
        "verified-ingame"
      ]
    },
    "seenInBuild": {
      "type": [
        "string",
        "null"
      ]
    },
    "kills": {
      "description": "What the objectives take: per unit/item objective the count asked for, the best drop chance (percent; 0 = only from objects) and the mob level (pipeline/normalize/kills.py).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "count",
          "chance",
          "level"
        ],
        "properties": {
          "kind": {
            "enum": [
              "kill",
              "collect"
            ]
          },
          "id": {
            "type": "integer"
          },
          "count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "chance": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "level": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  }
}
